[gd_resource type="Resource" script_class="Quest" format=3 uid="uid://brxychn5o3wmh"]

[ext_resource type="Script" uid="uid://cg4q1jcoxlcav" path="res://game/items/item_type.gd" id="9_8es61"]
[ext_resource type="PackedScene" uid="uid://x1e7xln0plg3" path="res://game/locations/parts/hollis_camp.tscn" id="camp_scene"]
[ext_resource type="PackedScene" uid="uid://cllgx1qdqcssm" path="res://game/locations/parts/hollis_dig_site.tscn" id="dig_scene"]
[ext_resource type="PackedScene" uid="uid://cnejc8qe1ltf4" path="res://game/locations/parts/outpost.tscn" id="outpost_scene"]
