[gd_resource type="Resource" script_class="NpcProfile" format=3 uid="uid://b3d5d8411ot80"]

[ext_resource type="Script" uid="uid://c8q6bkm7m3hp6" path="res://game/npcs/npc_profile.gd" id="1_profile"]
[ext_resource type="Script" uid="uid://ddeb65xhvagk2" path="res://game/npcs/dialogue.gd" id="2_dialogue"]
[ext_resource type="Script" uid="uid://w5l30l8frnjf" path="res://game/npcs/topic.gd" id="3_topic"]
[ext_resource type="Script" uid="uid://dn5vusrjjqgbe" path="res://game/npcs/crew_reaction.gd" id="9_reaction"]

[sub_resource type="Resource" id="Resource_greeting"]
script = ExtResource("3_topic")
id = &"pilot.greeting"
title = "Hello"
lines = Array[String](["There you are. I keep us flying, and every trip starts here at the navigator. Come over to the holo table whenever you want to pick where we go next.", "I'll take us anywhere the ship can reach. Where we land is your call, though: you're the ones who walk out there."])
away_lines = Array[String](["There you are. I keep us flying, and every trip starts at the navigator on the bridge. Meet me at the holo table whenever you want to pick where we go next.", "I'll take us anywhere the ship can reach. Where we land is your call, though: you're the ones who walk out there."])

[sub_resource type="Resource" id="Resource_navigator"]
script = ExtResource("3_topic")
id = &"pilot.navigator"
title = "The navigator"
lines = Array[String](["The holo table shows the whole system. Zoom in on a planet or a moon to see its regions, and zoom in on a region to see the spot where we would land.", "That last view lies the way the ship will touch down, with the ramp on the right like in here. Whatever you see beside the ship there, you'll find beside the ship outside.", "The beams are ore nodes, each in its ore's color, and places worth a look have a color of their own. So you can plan your way before you even leave."])
requires = Array[StringName]([&"pilot.greeting"])

[sub_resource type="Resource" id="Resource_regions"]
script = ExtResource("3_topic")
id = &"pilot.regions"
title = "Picking a region"
lines = Array[String](["For each region, the table shows how dangerous it is, how long you have before the storm, and which ores you'll find there.", "Some regions give you more time than others. If you're not sure where to go, start with an easy one.", "When you've found a spot you like, set it as our destination. Every time you pick a region, we land on a new stretch of it, so no two trips are quite the same."])
requires = Array[StringName]([&"pilot.greeting"])

[sub_resource type="Resource" id="Resource_flight"]
script = ExtResource("3_topic")
id = &"pilot.flight"
title = "Flying"
lines = Array[String](["Once we have a destination, I take us out from the cockpit as soon as everyone is aboard. Anyone there before me can pull the lever on the flight console.", "The flight takes a little while, so use it. Walk back to the armory, pick your weapons, and be at the ramp when we touch down.", "We can't set a new course during a mission. Once everyone is back aboard and the ramp is up, we take off again by ourselves."])
requires = Array[StringName]([&"pilot.greeting"])

[sub_resource type="Resource" id="Resource_ostra"]
script = ExtResource("3_topic")
id = &"pilot.ostra"
title = "Waypost Ostra"
lines = Array[String](["Waypost Ostra is the colony's station. It circles Torvane, and you'll find it at the navigator just like a region.", "While we're docked there, the ramp goes up and down whenever you like, and there's no storm to worry about. Take your time and talk to the people there.", "When we leave, I wait until everyone is back aboard. Nobody gets left behind at Ostra."])
requires = Array[StringName]([&"pilot.greeting"])

[sub_resource type="Resource" id="Resource_about"]
script = ExtResource("3_topic")
id = &"pilot.about"
title = "About Tamsin"
lines = Array[String](["Before this, I flew the haulers that brought the colony here. Months in the dark, with thousands of people asleep behind me.", "But these storms are something else. I've never seen weather like this anywhere. So when the warning comes out there, please don't make me wait for you."])
requires = Array[StringName]([&"pilot.greeting"])

[sub_resource type="Resource" id="Resource_dialogue"]
script = ExtResource("2_dialogue")
greeting = SubResource("Resource_greeting")
prompts = Array[String](["What's on your mind?", "Need something from me?", "Ask away, I've got a minute.", "Where do you want to go next?"])
topics = Array[ExtResource("3_topic")]([SubResource("Resource_navigator"), SubResource("Resource_regions"), SubResource("Resource_flight"), SubResource("Resource_ostra"), SubResource("Resource_about")])

[sub_resource type="Resource" id="Reaction_planet_opened_cassor"]
script = ExtResource("9_reaction")
event = &"planet_opened"
subject = &"cassor"
lines = Array[String](["Cassor is on the navigator now, and its moon Mirr with it. Closer to the star, the storms come in sooner, so I'll call earlier from now on."])

[sub_resource type="Resource" id="Reaction_planet_opened_zairen"]
script = ExtResource("9_reaction")
event = &"planet_opened"
subject = &"zairen"
lines = Array[String](["Zairen is on the navigator. That's as close to Kesh as anyone should ever fly. I'll get us there, and I'll get us back out."])

[sub_resource type="Resource" id="Reaction_first_landing_torvane"]
script = ExtResource("9_reaction")
event = &"first_landing"
subject = &"torvane"
lines = Array[String](["Torvane, our first landing. Most of it is dust and rock, with thick growth in the low places. I'll call on the radio when the storm comes."])

[sub_resource type="Resource" id="Reaction_first_landing_lisk"]
script = ExtResource("9_reaction")
event = &"first_landing"
subject = &"lisk"
lines = Array[String](["Lisk is a moon of ice. The ice out there is slick, and the cracks in it go deep."])

[sub_resource type="Resource" id="Reaction_first_landing_vehra"]
script = ExtResource("9_reaction")
event = &"first_landing"
subject = &"vehra"
lines = Array[String](["Welcome to Vehra. Ice, salt and dust, and all of it a little harsher than on Torvane. I'll keep the engines warm."])

[sub_resource type="Resource" id="Reaction_first_landing_cassor"]
script = ExtResource("9_reaction")
event = &"first_landing"
subject = &"cassor"
lines = Array[String](["Cassor. Salt flats and thick growth, and the ground in between doesn't always hold. There are sinkholes out there."])

[sub_resource type="Resource" id="Reaction_first_landing_mirr"]
script = ExtResource("9_reaction")
event = &"first_landing"
subject = &"mirr"
lines = Array[String](["Mirr is a small moon, nothing but dust and stone. It's quiet out there. Too quiet for my taste."])

[sub_resource type="Resource" id="Reaction_first_landing_orrel"]
script = ExtResource("9_reaction")
event = &"first_landing"
subject = &"orrel"
lines = Array[String](["We're on Orrel, one of Gaulm's moons. Salt and growth again, but everything here hits harder than anywhere before."])

[sub_resource type="Resource" id="Reaction_first_landing_iska"]
script = ExtResource("9_reaction")
event = &"first_landing"
subject = &"iska"
lines = Array[String](["Iska, Gaulm's other moon. Ice and dust, and colder than anywhere we've been. Nobody should stay out there longer than they have to."])

[sub_resource type="Resource" id="Reaction_first_landing_skelde"]
script = ExtResource("9_reaction")
event = &"first_landing"
subject = &"skelde"
lines = Array[String](["Skelde. Lava runs through the ash fields here, and the vents can burst at any moment. Standing still out there is a bad idea."])

[sub_resource type="Resource" id="Reaction_first_landing_zairen"]
script = ExtResource("9_reaction")
event = &"first_landing"
subject = &"zairen"
lines = Array[String](["Zairen. The heat has turned the ground to glass, and some of the shards are sharp enough to hurt. I'll be waiting right here."])

[sub_resource type="Resource" id="Reaction_storm_warning_solo"]
script = ExtResource("9_reaction")
event = &"storm_warning"
players = 1
lines = Array[String](["Storm's coming in. Get back to the ship.", "Storm front on the scanner. Time to head back.", "The storm is on its way. The ramp is down, so come on back.", "Here comes the weather. Finish up and get back aboard."])

[sub_resource type="Resource" id="Reaction_storm_warning_coop"]
script = ExtResource("9_reaction")
event = &"storm_warning"
players = 2
lines = Array[String](["Storm's coming in. Everyone back to the ship.", "Storm front on the scanner. Time to head back.", "The storm is on its way. The ramp is down, so come on back, all of you.", "Here comes the weather. Finish up, all of you, and get back aboard."])

[sub_resource type="Resource" id="Reaction_deposit_landed_solo"]
script = ExtResource("9_reaction")
event = &"deposit_landed"
players = 1
lines = Array[String](["Something came down out there, and it's glowing. If that's ore, it's the good kind. Go and take a look if you think you can make it.", "Did you hear that? A meteor just hit, and there's ore glowing in the crater. That much noise will have woken whatever lives nearby, so be careful.", "A meteor just came down out there. It brought something rich with it, by the look of that light. The way back from there is long, though."])

[sub_resource type="Resource" id="Reaction_deposit_landed_coop"]
script = ExtResource("9_reaction")
event = &"deposit_landed"
players = 2
lines = Array[String](["Something came down out there, and it's glowing. If that's ore, it's the good kind. Go and take a look if you think you can make it, all of you.", "Did you all hear that? A meteor just hit, and there's ore glowing in the crater. That much noise will have woken whatever lives nearby, so be careful.", "A meteor just came down out there. It brought something rich with it, by the look of that light. The way back from there is long, though, so stay together."])

[sub_resource type="Resource" id="Reaction_destination_rough_mire"]
script = ExtResource("9_reaction")
event = &"destination_rough"
subject = &"mire"
lines = Array[String](["Hollow Mire? It's rougher than the flats. If it were up to me, we'd get some upgrades first."])

[sub_resource type="Resource" id="Reaction_destination_rough"]
script = ExtResource("9_reaction")
event = &"destination_rough"
lines = Array[String](["That's rough ground for the gear we have. If it were up to me, we'd get some upgrades first.", "I'll fly us there, of course. It's just harder down there than our gear is made for, so a few upgrades first wouldn't hurt.", "It's not my call where we land. But I'd want better armor and better weapons before I walked out there."])

[sub_resource type="Resource" id="Reaction_region_landing_mire"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"mire"
lines = Array[String](["Hollow Mire. The nests here are thicker than in the flats, and the growth hides them until they're close. Better not stray far from the ship before you know your way around."])

[sub_resource type="Resource" id="Reaction_region_landing_cinder"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"cinder"
lines = Array[String](["Cinder Steps, the roughest ground on Torvane. The nests are thickest here, and the ore around the crater pulls crews in deeper than is good for them."])

[sub_resource type="Resource" id="Reaction_region_landing_rimeback"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"rimeback"
lines = Array[String](["Rimeback. The nests are thicker than in Pale Basin, and the frozen lakes are slick. The crystal wall is worth it, but a dead end has only one way out."])

[sub_resource type="Resource" id="Reaction_region_landing_glare"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"glare"
lines = Array[String](["Glare Fields. The nests are thicker than on Hoarfrost Ridge, and the salt is wide open: you see them coming from far off, and they see you."])

[sub_resource type="Resource" id="Reaction_region_landing_ember"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"ember"
lines = Array[String](["Ember Reach, the roughest place on Vehra. The nests are thickest here, and the canyons are narrow. Know your way back before you go looking for that wreck."])

[sub_resource type="Resource" id="Reaction_region_landing_brine"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"brine"
lines = Array[String](["Brine Terraces. The nests are thicker than in Sunken Verge, and there's little cover on the causeways. Keep your distance in a fight out there."])

[sub_resource type="Resource" id="Reaction_region_landing_whiteshelf"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"whiteshelf"
lines = Array[String](["Whiteshelf. The nests are thicker than in Sunken Verge, and the crater lies out in the open salt. The ore around it is worth the walk, but there's little cover on the way."])

[sub_resource type="Resource" id="Reaction_region_landing_mossgrave"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"mossgrave"
lines = Array[String](["Mossgrave, the roughest place on Cassor. The nests are thickest here, and the growth hides them until they're close. Don't go deep in without knowing your way back."])

[sub_resource type="Resource" id="Reaction_region_landing_quiet"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"quiet"
lines = Array[String](["Quiet Scar. The crews say it's quieter here than anywhere else, and none of them trust it. I don't either, so keep your eyes open."])

[sub_resource type="Resource" id="Reaction_region_landing_drift"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"drift"
lines = Array[String](["Drift Basin. The salt is wide open, so there's little cover from whatever comes. And that wreck looks as if it had always been there. I don't like it."])

[sub_resource type="Resource" id="Reaction_region_landing_lantern"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"lantern"
lines = Array[String](["Lantern Hollow, the roughest place on Orrel. The nests are thickest here, and the growth hides them. If you follow that beacon's light, know your way back."])

[sub_resource type="Resource" id="Reaction_region_landing_coldwake"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"coldwake"
lines = Array[String](["Coldwake. The ice has nearly taken the old outpost back, and the frozen lakes are slick. Mind your footing when something's after you."])

[sub_resource type="Resource" id="Reaction_region_landing_splitrock"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"splitrock"
lines = Array[String](["Splitrock Steps, the roughest place on Iska. The nests are thickest here, and the crystal wall sits at the end of a dead end, with only one way out."])

[sub_resource type="Resource" id="Reaction_region_landing_blacktide"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"blacktide"
lines = Array[String](["Black Tide. The nests are thicker than on Rustwind Plain, and the vents can burst at any moment. Stay off the scorched ground around them."])

[sub_resource type="Resource" id="Reaction_region_landing_brimstone"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"brimstone"
lines = Array[String](["Brimstone Cut. The nests are thicker than on Rustwind Plain, and the crystal wall is at the end of a dead end. Keep clear of the vents on the way."])

[sub_resource type="Resource" id="Reaction_region_landing_slag"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"slag"
lines = Array[String](["The Slag Terraces, the worst place on Skelde. The nests are thickest here, and the crossings over the lava are narrow. Know how you'll get back before you cross one."])

[sub_resource type="Resource" id="Reaction_region_landing_sunward"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"sunward"
lines = Array[String](["Sunward Scar. This close to the star, even the wreck out there has turned dark. Stay off the scorched ground: the vents don't give much warning."])

[sub_resource type="Resource" id="Reaction_region_landing_glassmere"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"glassmere"
lines = Array[String](["Glassmere. The splinters in the shard gardens hurt anyone standing on them. Whoever set up that old camp out here came farther in than anyone else."])

[sub_resource type="Resource" id="Reaction_region_landing_mirror"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"mirror"
lines = Array[String](["Mirror Flats, as rough as it gets on Zairen. The light off the glass is so bright you can barely see them coming, and the nests are thickest here."])

[sub_resource type="Resource" id="Reaction_region_landing_fused"]
script = ExtResource("9_reaction")
event = &"region_landing"
subject = &"fused"
lines = Array[String](["The Fused Expanse, as rough as it gets on Zairen. The crystal wall has the rarest ore, but it sits at the end of a dead end. Getting there is the easy part."])

[resource]
script = ExtResource("1_profile")
id = &"pilot"
display_name = "Tamsin"
role = "Pilot"
model = "uid://w8awig3b43xq"
activities = Array[StringName]([&"LookAround", &"Stretch", &"CheckWrist", &"Tap"])
accent_color = Color(0.3, 0.72, 1, 1)
cabin = 2
dialogue = SubResource("Resource_dialogue")
reactions = Array[ExtResource("9_reaction")]([SubResource("Reaction_planet_opened_cassor"), SubResource("Reaction_planet_opened_zairen"), SubResource("Reaction_first_landing_torvane"), SubResource("Reaction_first_landing_lisk"), SubResource("Reaction_first_landing_vehra"), SubResource("Reaction_first_landing_cassor"), SubResource("Reaction_first_landing_mirr"), SubResource("Reaction_first_landing_orrel"), SubResource("Reaction_first_landing_iska"), SubResource("Reaction_first_landing_skelde"), SubResource("Reaction_first_landing_zairen"), SubResource("Reaction_storm_warning_solo"), SubResource("Reaction_storm_warning_coop"), SubResource("Reaction_deposit_landed_solo"), SubResource("Reaction_deposit_landed_coop"), SubResource("Reaction_destination_rough_mire"), SubResource("Reaction_destination_rough"), SubResource("Reaction_region_landing_mire"), SubResource("Reaction_region_landing_cinder"), SubResource("Reaction_region_landing_rimeback"), SubResource("Reaction_region_landing_glare"), SubResource("Reaction_region_landing_ember"), SubResource("Reaction_region_landing_brine"), SubResource("Reaction_region_landing_whiteshelf"), SubResource("Reaction_region_landing_mossgrave"), SubResource("Reaction_region_landing_quiet"), SubResource("Reaction_region_landing_drift"), SubResource("Reaction_region_landing_lantern"), SubResource("Reaction_region_landing_coldwake"), SubResource("Reaction_region_landing_splitrock"), SubResource("Reaction_region_landing_blacktide"), SubResource("Reaction_region_landing_brimstone"), SubResource("Reaction_region_landing_slag"), SubResource("Reaction_region_landing_sunward"), SubResource("Reaction_region_landing_glassmere"), SubResource("Reaction_region_landing_mirror"), SubResource("Reaction_region_landing_fused")])
