[ext_resource type="Script" uid="uid://7vg4utlxx3ie" path="res://game/quests/quest_step.gd" id="s_step"]
[ext_resource type="Script" uid="uid://w5l30l8frnjf" path="res://game/npcs/topic.gd" id="s_topic"]

[sub_resource type="Resource" id="Topic_offer"]
script = ExtResource("s_topic")
id = &"depot_master.overdue"
title = "Overdue"
lines = Array[String](["Can I ask you something? There's an old prospector, Hollis, who works alone down in Hollow Mire. Every few weeks he comes up for his supplies, as regular as clockwork.", "This time he's three weeks late, and nobody has heard from him. His crates are still sitting on my shelf.", "He gave me the position of his camp once, in case something happened. I'll send it to your ship. Would you go down and see if he's all right?", "Hollow Mire isn't the flats, though. Get your gear in order before you go down there."])

[sub_resource type="Resource" id="RadioLine_landing"]
script = ExtResource("s_radio")
text = "Tamsin here. By Kade's position, Hollis' camp isn't far from where we landed. Go and see if he's all right."
coop_text = "Tamsin here. By Kade's position, Hollis' camp isn't far from where we landed. Go over together and see if he's all right."
speaker = &"pilot"

[sub_resource type="Resource" id="PartPlacement_camp"]
script = ExtResource("s_placement")
scene = ExtResource("camp_scene")
rule = 2

[sub_resource type="Resource" id="ReachGoal_camp"]
script = ExtResource("s_reach")
site_part = SubResource("PartPlacement_camp")
place = "Hollis' camp"
region = &"mire"
landing_line = SubResource("RadioLine_landing")

[sub_resource type="Resource" id="Topic_found"]
script = ExtResource("s_topic")
id = &"miner_mechanic.overdue_found"
title = "Kade sent us"
lines = Array[String](["Kade sent you, didn't he? Tell him I'm not dead yet. Just stuck.", "A nest grew up at my dig site, right on the vein I was working. Hauling my miner out of there cracked its drive coupling clean through.", "Burn that nest out, so I can get back to my vein, and find me a new coupling. The survey left crates all over this valley. One of them has one, if you look long enough."])

[sub_resource type="Resource" id="QuestStep_find"]
script = ExtResource("s_step")
id = &"find"
text = "Find Hollis' camp in Hollow Mire and see if he's all right."
goals = Array[ExtResource("s_goal")]([SubResource("ReachGoal_camp")])
hand_in_to = &"miner_mechanic"
meets_in = &"mire"
meets_at = SubResource("PartPlacement_camp")
place_prompts = Array[String](["Finally, somebody found me. I could use a hand with one of my old miners."])
hand_in = SubResource("Topic_found")

[sub_resource type="Resource" id="PartPlacement_dig"]
script = ExtResource("s_placement")
scene = ExtResource("dig_scene")
rule = 3

[sub_resource type="Resource" id="ClearNestsGoal_miner"]
script = ExtResource("s_nests")
amount = 1
site_part = SubResource("PartPlacement_dig")
task = "Clear the nest at his dig site"
region = &"mire"

[sub_resource type="Resource" id="PartPlacement_outpost"]
script = ExtResource("s_placement")
scene = ExtResource("outpost_scene")

[sub_resource type="Resource" id="RecoverFragmentsGoal_coupling"]
script = ExtResource("s_fragments")
amount = 1
site_part = SubResource("PartPlacement_outpost")
task = "Recover a drive coupling"
region = &"mire"

[sub_resource type="Resource" id="Topic_coupling"]
script = ExtResource("s_topic")
id = &"miner_mechanic.overdue_coupling"
title = "The coupling"
lines = Array[String](["That's the one. Give me a moment... There. Listen to her. Twenty years old, and she still sounds better than anything they build at Ostra.", "That ship of yours... I know her. I flew on her with the survey, back when she charted the lane. Didn't think I'd see her again.", "Your miners will need someone who knows them. I'm coming with you. Let me pack up, and I'll meet you at the ship."])

[sub_resource type="Resource" id="QuestStep_miner"]
script = ExtResource("s_step")
id = &"miner"
text = "Clear the nest at Hollis' dig site and find him a drive coupling in the crates of Hollow Mire."
goals = Array[ExtResource("s_goal")]([SubResource("ClearNestsGoal_miner"), SubResource("RecoverFragmentsGoal_coupling")])
hand_in_to = &"miner_mechanic"
meets_in = &"mire"
meets_at = SubResource("PartPlacement_camp")
place_prompts = Array[String](["Any luck with that coupling?", "Is the nest at my dig site gone yet?"])
hand_in = SubResource("Topic_coupling")
joins = &"miner_mechanic"

[resource]
script = ExtResource("s_quest")
id = &"overdue"
title = "Overdue"
giver = &"depot_master"
requires = Array[StringName]([&"depot_master.greeting"])
until = &"crew.miner_mechanic.joined"
offer = SubResource("Topic_offer")
steps = Array[ExtResource("s_step")]([SubResource("QuestStep_find"), SubResource("QuestStep_miner")])
