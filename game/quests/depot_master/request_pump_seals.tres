[sub_resource type="Resource" id="DeliverGoal_1"]
script = ExtResource("s_deliver")
item = ExtResource("ore_tessar")
amount = 100

[sub_resource type="Resource" id="Topic_2"]
script = ExtResource("s_topic")
id = &"depot_master.request_pump_seals_done"
title = "Pump seals"
lines = Array[String](["100 Tessar. Forty pumps, all sealed. The greenhouse crew owes you a salad."])

[sub_resource type="Resource" id="QuestStep_3"]
script = ExtResource("s_step")
id = &"deliver"
text = "Bring Kade 100 Tessar for the pump seals."
goals = Array[ExtResource("s_goal")]([SubResource("DeliverGoal_1")])
hand_in = SubResource("Topic_2")
items = Dictionary[ExtResource("s_item_type"), int]({ExtResource("ore_olvane"): 50})

[sub_resource type="Resource" id="Topic_4"]
script = ExtResource("s_topic")
id = &"depot_master.request_pump_seals"
title = "Pump seals"
lines = Array[String](["The hydroponics' pumps need Tessar seals, and we have six left for forty pumps. 100 Tessar would cover the rest of the year."])

[resource]
script = ExtResource("s_quest")
id = &"request_pump_seals"
title = "Pump seals"
kind = 2
giver = &"depot_master"
requires = Array[StringName]([&"depot_master.greeting"])
offer = SubResource("Topic_4")
steps = Array[ExtResource("s_step")]([SubResource("QuestStep_3")])
