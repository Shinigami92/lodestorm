[ext_resource type="Resource" uid="uid://7jm5s1jr48n5" path="res://game/weapons/types/brask/brask.tres" id="weapon_brask"]

[sub_resource type="Resource" id="Topic_19"]
script = ExtResource("s_topic")
id = &"quartermaster.job_colony_arms"
title = "About that job..."
lines = Array[String](["I've got a job for you, and it starts small. Ostra's workshops are running out of Kyrite, and without it, the repairs stop.", "So our first 300 Kyrite go to Kade at the depot. The colony looks after us, so we look after the colony.", "Do that well, and I'll have more for you after."])

[sub_resource type="Resource" id="DeliverGoal_1"]
script = ExtResource("s_deliver")
item = ExtResource("ore_kyrite")
amount = 300

[sub_resource type="Resource" id="Topic_2"]
script = ExtResource("s_topic")
id = &"depot_master.colony_arms_kyrite"
title = "Brannik's Kyrite"
lines = Array[String](["Three hundred Kyrite from Brannik's crew. He told me you'd come, and it's already in my books.", "That keeps the workshops going for about two weeks. I don't say that lightly.", "And since you're here: our surveyors left markers in Hollow Mire last month, and two nests have grown right next to them. Brannik said you'd see to it."])

[sub_resource type="Resource" id="QuestStep_3"]
script = ExtResource("s_step")
id = &"kyrite"
text = "Bring Kade 300 Kyrite at the depot on Waypost Ostra."
goals = Array[ExtResource("s_goal")]([SubResource("DeliverGoal_1")])
hand_in_to = &"depot_master"
hand_in = SubResource("Topic_2")

[sub_resource type="Resource" id="RadioLine_4"]
script = ExtResource("s_radio")
text = "Brannik here. The survey markers are somewhere down there, with the two nests beside them. Clear them out, and watch your back."
coop_text = "Brannik here. The survey markers are somewhere down there, with the two nests beside them. Clear them out, and watch each other's backs."

[sub_resource type="Resource" id="ClearNestsGoal_5"]
script = ExtResource("s_nests")
region = &"mire"
landing_line = SubResource("RadioLine_4")

[sub_resource type="Resource" id="Topic_6"]
script = ExtResource("s_topic")
id = &"quartermaster.colony_arms_nests"
title = "The survey nests"
lines = Array[String](["Kade will be pleased. Those markers cost the colony more than you'd think.", "Now, something of mine. On landfall day, a lander went down in Redscar Flats, with the colony's weapon blueprints aboard. Its crates ended up all over the flats.", "One of those blueprints is in three pieces somewhere in those crates. Bring them to me. And Tamsin doesn't talk about that day, so don't ask her."])

[sub_resource type="Resource" id="RadioLine_7"]
script = ExtResource("s_radio")
text = "Both nests are down. Good work. Now get back aboard in one piece."
coop_text = "Both nests are down. Good work. Now get back aboard in one piece, all of you."

[sub_resource type="Resource" id="QuestStep_8"]
script = ExtResource("s_step")
id = &"survey_nests"
text = "Destroy the two nests by the survey markers in Hollow Mire."
goals = Array[ExtResource("s_goal")]([SubResource("ClearNestsGoal_5")])
hand_in = SubResource("Topic_6")
items = Dictionary[ExtResource("s_item_type"), int]({
ExtResource("ore_olvane"): 60
})
ready_line = SubResource("RadioLine_7")

[sub_resource type="Resource" id="RadioLine_10"]
script = ExtResource("s_radio")
text = "The lander's crates are spread out down there. Open every one you find. Three pieces, that's all we need."
coop_text = "The lander's crates are spread out down there. Split up if you like, and open every one you find. Three pieces, that's all we need."

[sub_resource type="Resource" id="PartPlacement_9"]
script = ExtResource("s_placement")
scene = ExtResource("part_wreck")

[sub_resource type="Resource" id="RecoverFragmentsGoal_11"]
script = ExtResource("s_fragments")
site_part = SubResource("PartPlacement_9")
region = &"redscar"
landing_line = SubResource("RadioLine_10")

[sub_resource type="Resource" id="Topic_12"]
script = ExtResource("s_topic")
id = &"quartermaster.colony_arms_blueprint"
title = "The blueprint"
lines = Array[String](["Three pieces. That's a whole blueprint again.", "It's the shotgun the colony's guards carried. It doesn't reach far, but nothing gets close to you twice.", "I have my reasons for wanting you ready for what's further in. Build it, and show me it works."])

[sub_resource type="Resource" id="RadioLine_13"]
script = ExtResource("s_radio")
text = "That's all three pieces. Bring them home, and don't let anything take them off you."
coop_text = "That's all three pieces. Bring them home, all of you, and don't let anything take them off you."

[sub_resource type="Resource" id="QuestStep_14"]
script = ExtResource("s_step")
id = &"fragments"
text = "Recover the three blueprint fragments from the crates in Redscar Flats."
goals = Array[ExtResource("s_goal")]([SubResource("RecoverFragmentsGoal_11")])
hand_in = SubResource("Topic_12")
blueprint = ExtResource("weapon_brask")
ready_line = SubResource("RadioLine_13")

[sub_resource type="Resource" id="BuildGoal_15"]
script = ExtResource("s_build")
weapon = ExtResource("weapon_brask")

[sub_resource type="Resource" id="Topic_16"]
script = ExtResource("s_topic")
id = &"quartermaster.colony_arms_built"
title = "The shotgun"
lines = Array[String](["There it is. Treat it well, and it'll do the same for you.", "Try it on the range first. And ask me about it any time: I know a trick or two about loading shells."])

[sub_resource type="Resource" id="RadioLine_17"]
script = ExtResource("s_radio")
text = "Brannik here. I hear the shotgun is built. Come and show it to me."
coop_text = "Brannik here. I hear the shotgun is built. Come and show it to me, all of you."

[sub_resource type="Resource" id="QuestStep_18"]
script = ExtResource("s_step")
id = &"build"
text = "Build the shotgun from its blueprint."
goals = Array[ExtResource("s_goal")]([SubResource("BuildGoal_15")])
hand_in = SubResource("Topic_16")
items = Dictionary[ExtResource("s_item_type"), int]({
ExtResource("ore_vyrel"): 40
})
ready_line = SubResource("RadioLine_17")

[resource]
script = ExtResource("s_quest")
id = &"colony_arms"
title = "A good welcome"
giver = &"quartermaster"
requires = Array[StringName]([&"beat.first_job"])
offer = SubResource("Topic_19")
steps = Array[ExtResource("s_step")]([SubResource("QuestStep_3"), SubResource("QuestStep_8"), SubResource("QuestStep_14"), SubResource("QuestStep_18")])
