[gd_resource type="Resource" script_class="NpcProfile" format=3 uid="uid://cxih2upgkspuc"]

[ext_resource type="Script" uid="uid://c8q6bkm7m3hp6" path="res://game/npcs/npc_profile.gd" id="1_profile"]
[ext_resource type="Script" uid="uid://ddeb65xhvagk2" path="res://game/npcs/dialogue.gd" id="2_dialogue"]
[ext_resource type="Script" uid="uid://w5l30l8frnjf" path="res://game/npcs/topic.gd" id="3_topic"]
[ext_resource type="Script" uid="uid://dn5vusrjjqgbe" path="res://game/npcs/crew_reaction.gd" id="9_reaction"]

[sub_resource type="Resource" id="Resource_greeting"]
script = ExtResource("3_topic")
id = &"medic.greeting"
title = "Hello"
lines = Array[String](["Come in. This is my medical bay, and I'd rather see you walk in here than wake up here.", "But whatever happens out there, this is where you wake up again. Ask me anything about staying in one piece."])

[sub_resource type="Resource" id="Resource_wounds"]
script = ExtResource("3_topic")
id = &"medic.wounds"
title = "Wounds"
lines = Array[String](["Your wounds don't just go away when the ramp closes. If you come back hurt, you start the next mission just as hurt.", "So before you go out again, lie down on one of the med beds here. It doesn't cost you anything.", "If you forget, the ramp button reminds you once. After that, it's up to you."])
requires = Array[StringName]([&"medic.greeting"])

[sub_resource type="Resource" id="Resource_beds"]
script = ExtResource("3_topic")
id = &"medic.beds"
title = "Med beds"
lines = Array[String](["Lie down on a free bed, and it heals you up to full health. The smaller the wound, the sooner it's done.", "Stay on it until you're fully healed, then get up, and you're ready to go.", "There are four beds, so all of you can lie down at the same time."])
requires = Array[StringName]([&"medic.greeting"])

[sub_resource type="Resource" id="Resource_falling"]
script = ExtResource("3_topic")
id = &"medic.falling"
title = "Falling out there"
lines = Array[String](["If you fall out there, you lose the ore you're carrying, and you wake up here at full health.", "When you're alone out there, falling ends the mission. You wake up here, and the next run needs a new destination.", "With others, you stay down until the mission is over. So look out for each other."])
requires = Array[StringName]([&"medic.greeting"])

[sub_resource type="Resource" id="Resource_about"]
script = ExtResource("3_topic")
id = &"medic.about"
title = "About Ilse"
lines = Array[String](["I used to run the clinic at Ostra. The council's reports say the storms are nothing to worry about.", "Then I count the injuries that come back from these runs. The numbers don't match the reports, so I'm keeping my own."])
requires = Array[StringName]([&"medic.greeting"])

[sub_resource type="Resource" id="Resource_dialogue"]
script = ExtResource("2_dialogue")
greeting = SubResource("Resource_greeting")
prompts = Array[String](["What can I do for you?", "How are you feeling?", "Ask me anything. I have a moment.", "Is something bothering you?"])
topics = Array[ExtResource("3_topic")]([SubResource("Resource_wounds"), SubResource("Resource_beds"), SubResource("Resource_falling"), SubResource("Resource_about")])

[sub_resource type="Resource" id="Reaction_first_death"]
script = ExtResource("9_reaction")
event = &"first_death"
lines = Array[String](["Easy, take a breath. You fell out there and woke up in my medical bay. It happens to everyone once. Let's make sure it doesn't happen often."])

[resource]
script = ExtResource("1_profile")
id = &"medic"
display_name = "Ilse"
role = "Medic"
model = "uid://bw2g35qmntsii"
activities = Array[StringName]([&"LookAround", &"Stretch", &"CheckWrist", &"Tap"])
accent_color = Color(0.9, 0.94, 1, 1)
cabin = 4
dialogue = SubResource("Resource_dialogue")
reactions = Array[ExtResource("9_reaction")]([SubResource("Reaction_first_death")])
