[gd_resource type="Resource" script_class="NpcProfile" format=3 uid="uid://btff2f4twhwue"]

[ext_resource type="Script" uid="uid://c8q6bkm7m3hp6" path="res://game/npcs/npc_profile.gd" id="1_profile"]
[ext_resource type="Script" uid="uid://ddeb65xhvagk2" path="res://game/npcs/dialogue.gd" id="2_dialogue"]
[ext_resource type="Script" uid="uid://w5l30l8frnjf" path="res://game/npcs/topic.gd" id="3_topic"]
[ext_resource type="Resource" uid="uid://7jm5s1jr48n5" path="res://game/weapons/types/brask/brask.tres" id="4_brask"]
[ext_resource type="Script" uid="uid://dn5vusrjjqgbe" path="res://game/npcs/crew_reaction.gd" id="9_reaction"]

[sub_resource type="Resource" id="Resource_greeting"]
script = ExtResource("3_topic")
id = &"quartermaster.greeting"
title = "Hello"
lines = Array[String](["Good, you're here. Before the next mission, let me go over the armory with you. Keeping your gear and your ammo in order is my job.", "At your locker, pick the weapons you want to take on a mission. You can only carry up to two at a time, though.", "During a mission, you only have the weapons you carry. So choose wisely, or we'll be welcoming you in the medical bay.", "If you have questions about ammo or reloading, just ask me. Better here than out there with a swarm on your back."])

[sub_resource type="Resource" id="Resource_ammo"]
script = ExtResource("3_topic")
id = &"quartermaster.ammo"
title = "Ammo"
lines = Array[String](["Out there, your suit makes new rounds from the ore you carry on your back. Any kind of ore works. It always uses the lowest-quality ore first, so your rare ore lasts longest.", "The rarer the ore, the more rounds you get from the same amount.", "Once your spare magazines are used up, you can't reload without ore. So get your miners going early, or take Dray along: a hammer needs no ammo.", "Aboard, every reload is free: the rounds come from the ship's stock."])
requires = Array[StringName]([&"quartermaster.greeting"])

[sub_resource type="Resource" id="Resource_spares"]
script = ExtResource("3_topic")
id = &"quartermaster.spares"
title = "Spare magazines"
lines = Array[String](["Every ranged weapon you take along starts each mission with two spare magazines from the ship's stock. When you reload, those are used first, and they cost you no ore.", "Out there, they show up as short marks in the ring around your feet, inside its right half, whenever you reload. A mark that's only an outline is a magazine you've used up.", "Your suit can't make new spare magazines out there. Once they're gone, you pay for every reload with the ore you carry."])
requires = Array[StringName]([&"quartermaster.greeting"])

[sub_resource type="Resource" id="Resource_reload"]
script = ExtResource("3_topic")
id = &"quartermaster.reload"
title = "Reloading"
lines = Array[String](["You can reload whenever you want, as long as you still have a spare magazine or ore to pay for it. When the magazine runs empty, your weapon reloads by itself.", "But careful with Harl: reloading throws away the rounds still left in the magazine. So don't reload a half-full magazine just out of habit.", "While you reload, you walk slower. So pick a moment when nothing is right on your heels."])
requires = Array[StringName]([&"quartermaster.greeting"])

[sub_resource type="Resource" id="Resource_timing"]
script = ExtResource("3_topic")
id = &"quartermaster.timing"
title = "Timing reload"
lines = Array[String](["Here's a trick: press reload a second time while you're reloading. The right half of the ring around your feet fills up while you reload, and it has a white mark.", "Press right when the ring reaches the white mark, and the reload is finished at once. Press too early or too late, and it takes longer instead.", "If you don't press a second time at all, it just takes the normal time. So try it at the shooting range first, where it costs you nothing."])
requires = Array[StringName]([&"quartermaster.reload"])

[sub_resource type="Resource" id="Resource_brask"]
script = ExtResource("3_topic")
id = &"quartermaster.shotgun"
title = "Brask"
lines = Array[String](["So you've got Brask now, the shotgun. It has no magazine: it loads one shell after another, and keeps the shells that are already in.", "Pull the trigger in the middle of a reload, and it stops reloading and fires what's loaded.", "The timing trick works on every single shell. Time several shells in a row, and each one loads a bit quicker. Miss one or skip a press, and that bonus starts over."])
requires = Array[StringName]([&"quartermaster.greeting"])
requires_weapon = ExtResource("4_brask")

[sub_resource type="Resource" id="Resource_range"]
script = ExtResource("3_topic")
id = &"quartermaster.range"
title = "Shooting range"
lines = Array[String](["Right next door is the shooting range. Whenever you get a new weapon, try it out there before you take it on a mission.", "Reloads there are free, so you can practice the timing as often as you like. The targets stand at the far end.", "Weapons only work inside the range, and a force field in the doorway stops every shot. Nothing leaves that room."])
requires = Array[StringName]([&"quartermaster.greeting"])

[sub_resource type="Resource" id="Resource_dialogue"]
script = ExtResource("2_dialogue")
greeting = SubResource("Resource_greeting")
topics = Array[ExtResource("3_topic")]([SubResource("Resource_ammo"), SubResource("Resource_spares"), SubResource("Resource_reload"), SubResource("Resource_timing"), SubResource("Resource_brask"), SubResource("Resource_range")])

[sub_resource type="Resource" id="Reaction_first_run_won_solo"]
script = ExtResource("9_reaction")
event = &"first_run_won"
players = 1
lines = Array[String](["You made it back in one piece, and with ore on your back. That's how I like a first mission to end."])

[sub_resource type="Resource" id="Reaction_first_run_won_coop"]
script = ExtResource("9_reaction")
event = &"first_run_won"
players = 2
lines = Array[String](["Everyone made it back in one piece, and with ore on their backs. That's how I like a first mission to end."])

[sub_resource type="Resource" id="Reaction_weapon_built"]
script = ExtResource("9_reaction")
event = &"weapon_built"
lines = Array[String](["I hear you've got a new weapon. If you want to take it along, pick it at your locker before the next mission.", "Another one for the armory. You'll find it on the wall with the others, so take whatever suits the next mission best.", "A new weapon is only as good as the hands holding it. Spend some time at the shooting range before the next mission."])

[sub_resource type="Resource" id="Reaction_big_haul"]
script = ExtResource("9_reaction")
event = &"big_haul"
lines = Array[String](["Now that's a haul. With that much ore aboard, a few of those upgrades are finally in reach.", "Good haul. Careless crews don't stay lucky for long, though. The next mission can go wrong just as fast.", "Another big haul. Keep this up, and Dace and Wren won't have a quiet minute."])

[resource]
script = ExtResource("1_profile")
id = &"quartermaster"
display_name = "Brannik"
role = "Quartermaster"
model = "uid://r7da5xautqps"
accent_color = Color(0.65, 0.45, 1, 1)
dialogue = SubResource("Resource_dialogue")
reactions = Array[ExtResource("9_reaction")]([SubResource("Reaction_first_run_won_solo"), SubResource("Reaction_first_run_won_coop"), SubResource("Reaction_weapon_built"), SubResource("Reaction_big_haul")])
