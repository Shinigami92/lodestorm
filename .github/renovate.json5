{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "schedule:earlyMondays",
    "group:allNonMajor",
    ":prHourlyLimitNone"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      // An engine update needs its own review: editor re-saves project.godot, GUT must support it
      "groupName": "Godot",
      "matchDepNames": ["godotengine/godot"]
    },
    {
      // Own branch renovate/godot-ai: the godot-ai-plugin workflow commits the matching editor
      // plugin in addons/godot_ai/ to it (tests/project/test_addon_versions.gd fails until then)
      "groupName": "godot-ai",
      "matchDepNames": ["godot-ai"]
    }
  ],
  // The godot-ai-plugin workflow's commits don't count as manual edits, so Renovate keeps rebasing
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.godot-version$/"],
      "matchStrings": ["^(?<currentValue>\\S+)\\s*$"],
      "depNameTemplate": "godotengine/godot",
      "datasourceTemplate": "github-releases",
      // Only stable releases; Godot names x.y.0 releases "x.y"
      "extractVersionTemplate": "^(?<version>.+)-stable$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.mcp\\.json$/"],
      "matchStrings": ["\"(?<depName>godot-ai)==(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "pypi"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"]
  }
}
