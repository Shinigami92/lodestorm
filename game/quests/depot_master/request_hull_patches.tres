[sub_resource type="Resource" id="Topic_4"]
script = ExtResource("s_topic")
id = &"depot_master.request_hull_patches"
title = "Hull patches"
lines = Array[String](["Debris hit the docking ring yesterday, in four places. The patches are made of Olvane, so I need 120 of it."])

[sub_resource type="Resource" id="DeliverGoal_1"]
script = ExtResource("s_deliver")
item = ExtResource("ore_olvane")
amount = 120

[sub_resource type="Resource" id="Topic_2"]
script = ExtResource("s_topic")
id = &"depot_master.request_hull_patches_done"
title = "Hull patches"
lines = Array[String](["120 Olvane. Four patches, and the ring holds pressure again. Thank you."])

[sub_resource type="Resource" id="QuestStep_3"]
script = ExtResource("s_step")
id = &"deliver"
text = "Bring Kade 120 Olvane for the hull patches."
goals = Array[ExtResource("s_goal")]([SubResource("DeliverGoal_1")])
hand_in = SubResource("Topic_2")
items = Dictionary[ExtResource("s_item_type"), int]({
ExtResource("ore_pallin"): 60
})

[resource]
script = ExtResource("s_quest")
id = &"request_hull_patches"
title = "Hull patches"
kind = 2
giver = &"depot_master"
requires = Array[StringName]([&"depot_master.greeting"])
offer = SubResource("Topic_4")
steps = Array[ExtResource("s_step")]([SubResource("QuestStep_3")])
