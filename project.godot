[internationalization]

locale/translations=["res://locale/de.po"]

[navigation]

3d/warnings/navmesh_edge_merge_errors=false
3d/default_cell_size=0.5
3d/merge_rasterizer_cell_scale=0.01

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=1

[shader_globals]

cutaway_camera={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
cutaway_target={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
