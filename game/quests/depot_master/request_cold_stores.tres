[sub_resource type="Resource" id="DeliverGoal_1"]
script = ExtResource("s_deliver")
item = ExtResource("ore_pallin")
amount = 100

[sub_resource type="Resource" id="Topic_2"]
script = ExtResource("s_topic")
id = &"depot_master.request_cold_stores_done"
title = "Cold stores"
lines = Array[String](["100 Pallin. That's one month of food I don't have to worry about."])

[sub_resource type="Resource" id="QuestStep_3"]
script = ExtResource("s_step")
id = &"deliver"
text = "Bring Kade 100 Pallin for the cold stores."
goals = Array[ExtResource("s_goal")]([SubResource("DeliverGoal_1")])
hand_in = SubResource("Topic_2")
items = Dictionary[ExtResource("s_item_type"), int]({ExtResource("ore_kyrite"): 50})

[sub_resource type="Resource" id="Topic_4"]
script = ExtResource("s_topic")
id = &"depot_master.request_cold_stores"
title = "Cold stores"
lines = Array[String](["The cold stores need Pallin for their cooling lines. If they fail, we lose a month of food, so I'd like 100 Pallin before they do."])

[resource]
script = ExtResource("s_quest")
id = &"request_cold_stores"
title = "Cold stores"
kind = 2
giver = &"depot_master"
requires = Array[StringName]([&"depot_master.greeting"])
offer = SubResource("Topic_4")
steps = Array[ExtResource("s_step")]([SubResource("QuestStep_3")])
