[sub_resource type="Resource" id="Topic_4"]
script = ExtResource("s_topic")
id = &"depot_master.request_air_scrubbers"
title = "Air scrubbers"
lines = Array[String](["Every air scrubber on this station has a Halcyne core, and nine of them are wearing out. 60 Halcyne would replace them all."])

[sub_resource type="Resource" id="DeliverGoal_1"]
script = ExtResource("s_deliver")
item = ExtResource("ore_halcyne")
amount = 60

[sub_resource type="Resource" id="Topic_2"]
script = ExtResource("s_topic")
id = &"depot_master.request_air_scrubbers_done"
title = "Air scrubbers"
lines = Array[String](["60 Halcyne. Nine new cores. Everyone aboard breathes a little easier, even if they never find out why."])

[sub_resource type="Resource" id="QuestStep_3"]
script = ExtResource("s_step")
id = &"deliver"
text = "Bring Kade 60 Halcyne for the air scrubbers."
goals = Array[ExtResource("s_goal")]([SubResource("DeliverGoal_1")])
hand_in = SubResource("Topic_2")
items = Dictionary[ExtResource("s_item_type"), int]({
ExtResource("ore_duskine"): 30
})

[resource]
script = ExtResource("s_quest")
id = &"request_air_scrubbers"
title = "Air scrubbers"
kind = 2
giver = &"depot_master"
requires = Array[StringName]([&"depot_master.greeting"])
offer = SubResource("Topic_4")
steps = Array[ExtResource("s_step")]([SubResource("QuestStep_3")])
