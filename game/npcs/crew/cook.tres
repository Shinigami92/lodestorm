[sub_resource type="Resource" id="Resource_greeting"]
script = ExtResource("3_topic")
id = &"cook.greeting"
title = "Hello"
lines = Array[String](["Hungry? Sit down anywhere. It's not fancy, but it's warm, and nobody out there is going to cook for you.", "Everyone comes through my mess hall sooner or later. So if you want to know what's going on aboard, I'm the one to ask."])
away_lines = Array[String](["Hungry? Come by the mess hall and sit down anywhere. It's not fancy, but it's warm, and nobody out there is going to cook for you.", "Everyone comes through my mess hall sooner or later. So if you want to know what's going on aboard, I'm the one to ask."])

[sub_resource type="Resource" id="Resource_crew"]
script = ExtResource("3_topic")
id = &"cook.crew"
title = "The crew"
lines = Array[String](["Brannik runs the armory and the ammo. Dace improves your weapons in the weapons room, and Wren looks after your suit in the room next door.", "Hollis keeps the miners going. Ilse has the medical bay at the nose, and Okoro is down in the engine room with the heat shield.", "Tamsin flies the ship. You'll find her on the bridge, or in the cockpit while we're flying. And you'll always find me in the mess hall."])
requires = Array[StringName]([&"cook.greeting", &"crew.gunsmith.joined", &"crew.suit_tech.joined", &"crew.miner_mechanic.joined"])

[sub_resource type="Resource" id="Resource_news"]
script = ExtResource("3_topic")
id = &"cook.news"
title = "News"
lines = Array[String](["If you want news from the rest of the colony, dock at Waypost Ostra. Tamsin can take you there any time.", "Have a drink at the bar while you're there. Nell hears even more gossip than I do, and that's saying something."])
requires = Array[StringName]([&"cook.greeting"])

[sub_resource type="Resource" id="Resource_about"]
script = ExtResource("3_topic")
id = &"cook.about"
title = "About Fenna"
lines = Array[String](["I signed on to cook, but mostly I listen. Over a hot meal, people say more than they'd ever admit.", "Most of what I hear is nonsense. Some of it isn't. The trick is telling the difference."])
requires = Array[StringName]([&"cook.greeting"])

[sub_resource type="Resource" id="Resource_dialogue"]
script = ExtResource("2_dialogue")
greeting = SubResource("Resource_greeting")
prompts = Array[String](["What'll it be?", "Hungry, or just curious?", "Go on, I've got a pot on, but I'm listening.", "Hey, you. What's on your mind?"])
topics = Array[ExtResource("3_topic")]([SubResource("Resource_crew"), SubResource("Resource_news"), SubResource("Resource_about")])

[sub_resource type="Resource" id="Reaction_planet_opened_gaulm"]
script = ExtResource("9_reaction")
event = &"planet_opened"
subject = &"gaulm"
lines = Array[String](["Moons around a gas giant! When I signed on, I never thought I'd see Gaulm out of a window. Somebody has to tell me what it looks like from down there."])

[resource]
script = ExtResource("1_profile")
id = &"cook"
join_flag = &"crew.cook.joined"
display_name = "Fenna"
role = "Cook"
model = "uid://vo056vbv74lc"
activities = Array[StringName]([&"LookAround", &"Stretch", &"CheckWrist", &"Tap"])
accent_color = Color(1, 0.55, 0.8, 1)
cabin = 8
dialogue = SubResource("Resource_dialogue")
reactions = Array[ExtResource("9_reaction")]([SubResource("Reaction_planet_opened_gaulm")])
