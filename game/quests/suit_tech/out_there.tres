[gd_resource type="Resource" script_class="Quest" format=3 uid="uid://bc2klc84e822n"]

[ext_resource type="Script" uid="uid://w5l30l8frnjf" path="res://game/npcs/topic.gd" id="s_topic"]
[ext_resource type="Script" uid="uid://bdto4xx2jvios" path="res://game/quests/quest.gd" id="s_quest"]
[ext_resource type="Script" uid="uid://7vg4utlxx3ie" path="res://game/quests/quest_step.gd" id="s_step"]
[ext_resource type="Script" uid="uid://bbh57jogeoedv" path="res://game/quests/quest_goal.gd" id="s_goal"]
[ext_resource type="Script" uid="uid://dwkdaijmiqcvw" path="res://game/quests/radio_line.gd" id="s_radio"]
[ext_resource type="Script" uid="uid://bw3tdlxmcsmku" path="res://game/locations/parts/part_placement.gd" id="s_placement"]
[ext_resource type="Script" uid="uid://d4oba3ngd53d" path="res://game/quests/recover_fragments_goal.gd" id="s_fragments"]
[ext_resource type="PackedScene" uid="uid://cnejc8qe1ltf4" path="res://game/locations/parts/outpost.tscn" id="outpost_scene"]

[sub_resource type="Resource" id="Topic_offer"]
script = ExtResource("s_topic")
id = &"suit_tech.out_there"
title = "Out there"
lines = Array[String](["Can I ask you something? Ships like yours have a room just for suits. Who looks after yours? I could do that. Nobody on this station knows suits better than I do.", "But first I'd need a planet suit of my own. Every suit on Ostra is made for the docks, not for the storms down there. My father was with the survey, and he says its old crates on Cinder Steps still hold one, in pieces.", "He also says it's the roughest place on Torvane, so get ready first. Bring me the pieces, and I'll put the suit back together. And then take me with you?"])

[sub_resource type="Resource" id="RadioLine_landing"]
script = ExtResource("s_radio")
text = "Tamsin here. Wren's suit is in the survey's old crates somewhere down here. Open every one you find, and watch your step."
coop_text = "Tamsin here. Wren's suit is in the survey's old crates somewhere down here. Open every one you find, and watch each other's backs."
speaker = &"pilot"

[sub_resource type="Resource" id="PartPlacement_outpost"]
script = ExtResource("s_placement")
scene = ExtResource("outpost_scene")

[sub_resource type="Resource" id="RecoverFragmentsGoal_suit"]
script = ExtResource("s_fragments")
site_part = SubResource("PartPlacement_outpost")
task = "Recover the suit's pieces"
region = &"cinder"
landing_line = SubResource("RadioLine_landing")

[sub_resource type="Resource" id="RadioLine_ready"]
script = ExtResource("s_radio")
text = "That's the last piece. Now get the pieces back to the ship."
coop_text = "That's the last piece. Now everyone back to the ship with the pieces."
speaker = &"pilot"

[sub_resource type="Resource" id="Topic_suit"]
script = ExtResource("s_topic")
id = &"suit_tech.out_there_suit"
title = "The survey suit"
lines = Array[String](["Is that all of it? Look at these seals! Nobody on Ostra could ever make seals like these.", "It needs work, but I can do that aboard. The first time I step onto a planet, I'll be wearing this.", "I'll grab my bag. Don't you dare leave without me!"])

[sub_resource type="Resource" id="QuestStep_suit"]
script = ExtResource("s_step")
id = &"suit"
text = "Recover the pieces of an old survey suit from the crates of Cinder Steps."
goals = Array[ExtResource("s_goal")]([SubResource("RecoverFragmentsGoal_suit")])
place_prompts = Array[String](["Any luck on Cinder Steps?"])
hand_in = SubResource("Topic_suit")
joins = &"suit_tech"
ready_line = SubResource("RadioLine_ready")

[resource]
script = ExtResource("s_quest")
id = &"out_there"
title = "Out there"
giver = &"suit_tech"
requires = Array[StringName]([&"suit_tech.about_bench"])
until = &"crew.suit_tech.joined"
offer = SubResource("Topic_offer")
steps = Array[ExtResource("s_step")]([SubResource("QuestStep_suit")])
