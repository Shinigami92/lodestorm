[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/armory_menu.gd" id="1_script"]
[ext_resource type="Theme" path="res://assets/ui/terminal_theme.tres" id="2_theme"]
[ext_resource type="Resource" path="res://scenes/weapons/all_weapons.tres" id="3_catalog"]

[node name="ArmoryMenu" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")
catalog = ExtResource("3_catalog")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Header" type="HBoxContainer" parent="Layout"]
layout_mode = 2

[node name="Title" type="Label" parent="Layout/Header"]
