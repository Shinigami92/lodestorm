[gd_resource type="Resource" script_class="NpcProfile" format=3 uid="uid://dvd7ogckuu0u5"]

[ext_resource type="Script" uid="uid://c8q6bkm7m3hp6" path="res://game/npcs/npc_profile.gd" id="1_profile"]
[ext_resource type="Script" uid="uid://ddeb65xhvagk2" path="res://game/npcs/dialogue.gd" id="2_dialogue"]
[ext_resource type="Script" uid="uid://w5l30l8frnjf" path="res://game/npcs/topic.gd" id="3_topic"]
[ext_resource type="PackedScene" uid="uid://gp5xyxp3eil3" path="res://game/npcs/crew/accessories/engineer.tscn" id="4_accessory"]
[ext_resource type="Script" uid="uid://dn5vusrjjqgbe" path="res://game/npcs/crew_reaction.gd" id="9_reaction"]

[sub_resource type="Resource" id="Resource_greeting"]
script = ExtResource("3_topic")
id = &"engineer.greeting"
title = "Hello"
lines = Array[String](["Ah, good, come and look at this: the drive core, and the heat shield around it. It's what keeps us alive when we fly closer to the star.", "I look after the engine room and the cargo bay. If you want to know how we get further in, or what happens to the ore you bring back, ask me."])

[sub_resource type="Resource" id="Resource_shield"]
script = ExtResource("3_topic")
id = &"engineer.shield"
title = "The heat shield"
lines = Array[String](["The closer we get to the star, the hotter it burns, so the shield needs a new plate for every step further in. The installed plates glow, and the next one fills up as it's paid.", "A plate costs ore. Select it, and its card shows how much is paid already and how much your hold has.", "Make it the ship's project, and every run pays into it first, before the rest goes into your hold. Or pay the rest from your hold right away.", "As soon as a plate is paid, I install it. If you're out there with others, though, only the host can work on the shield."])
requires = Array[StringName]([&"engineer.greeting"])

[sub_resource type="Resource" id="Resource_further_in"]
script = ExtResource("3_topic")
id = &"engineer.further_in"
title = "Further in"
lines = Array[String](["Every new plate takes us closer to the star. The ores get rarer there, and the aliens get tougher and hit harder.", "The storm comes sooner there, too, and it hurts more. So don't rush in before your gear is ready for it.", "The good news is that every plate also lets the crew take your weapons, your armor and your miners one level higher."])
requires = Array[StringName]([&"engineer.greeting"])

[sub_resource type="Resource" id="Resource_hold"]
script = ExtResource("3_topic")
id = &"engineer.hold"
title = "Your hold"
lines = Array[String](["Everything you bring back from a run goes into your own hold, back in the cargo bay. Each of you has one.", "There's a silo for every ore. The number on top tells you exactly how much you have, and a silo with a question mark holds an ore that nobody has brought aboard yet.", "Upgrades, skills and new builds are all paid from your hold. So have a look at the silos before you spend."])
requires = Array[StringName]([&"engineer.greeting"])

[sub_resource type="Resource" id="Resource_refinery"]
script = ExtResource("3_topic")
id = &"engineer.refinery"
title = "The refinery"
lines = Array[String](["The four furnaces in the cargo bay turn ore into alloy bars. Better gear needs those bars sooner or later.", "Right now they're all cold. I'm still working on getting them going, and I'll tell you when the first one is ready.", "Every alloy has its own recipe, and a recipe only shows once every ore it needs has been in your hold. The rack next to the furnaces holds your bars."])
requires = Array[StringName]([&"engineer.greeting"])

[sub_resource type="Resource" id="Resource_about"]
script = ExtResource("3_topic")
id = &"engineer.about"
title = "About Okoro"
lines = Array[String](["I came out here to study the star. Kesh is restless, more than anyone expected when the colony was planned.", "This shield is the best answer I have so far. Every plate we install teaches me something new, and I write all of it down."])
requires = Array[StringName]([&"engineer.greeting"])

[sub_resource type="Resource" id="Resource_dialogue"]
script = ExtResource("2_dialogue")
greeting = SubResource("Resource_greeting")
topics = Array[ExtResource("3_topic")]([SubResource("Resource_shield"), SubResource("Resource_further_in"), SubResource("Resource_hold"), SubResource("Resource_refinery"), SubResource("Resource_about")])

[sub_resource type="Resource" id="Reaction_planet_opened_vehra"]
script = ExtResource("9_reaction")
event = &"planet_opened"
subject = &"vehra"
lines = Array[String](["The new plate holds. Vehra is in reach now, the next planet inwards. The aliens there are tougher than on Torvane."])

[sub_resource type="Resource" id="Reaction_planet_opened_skelde"]
script = ExtResource("9_reaction")
event = &"planet_opened"
subject = &"skelde"
lines = Array[String](["Skelde is in reach now. Most of it is ash and lava, and the star feels close enough to touch. The shield holds, but only just."])

[sub_resource type="Resource" id="Reaction_big_haul"]
script = ExtResource("9_reaction")
event = &"big_haul"
lines = Array[String](["That was quite a haul. The silos have never been this full, and this ship runs on hauls like that.", "I had to look twice at the numbers on the silos. That's the biggest haul this ship has seen so far.", "Another record haul. At this rate, I'll need a bigger cargo bay."])

[resource]
script = ExtResource("1_profile")
id = &"engineer"
display_name = "Okoro"
role = "Engineer"
accent_color = Color(1, 0.5, 0.12, 1)
accessory = ExtResource("4_accessory")
cabin = 3
dialogue = SubResource("Resource_dialogue")
reactions = Array[ExtResource("9_reaction")]([SubResource("Reaction_planet_opened_vehra"), SubResource("Reaction_planet_opened_skelde"), SubResource("Reaction_big_haul")])
