[sub_resource type="Resource" id="Topic_4"]
script = ExtResource("s_topic")
id = &"depot_master.request_filter_frames"
title = "Filter frames"
lines = Array[String](["The water recyclers' filter frames are made of Kyrite, and three of them cracked this week. I need 150 Kyrite to replace them."])

[sub_resource type="Resource" id="DeliverGoal_1"]
script = ExtResource("s_deliver")
item = ExtResource("ore_kyrite")
amount = 150

[sub_resource type="Resource" id="Topic_2"]
script = ExtResource("s_topic")
id = &"depot_master.request_filter_frames_done"
title = "Filter frames"
lines = Array[String](["150 Kyrite, logged. That's three new frames and two spare ones."])

[sub_resource type="Resource" id="QuestStep_3"]
script = ExtResource("s_step")
id = &"deliver"
text = "Bring Kade 150 Kyrite for the filter frames."
goals = Array[ExtResource("s_goal")]([SubResource("DeliverGoal_1")])
hand_in = SubResource("Topic_2")
items = Dictionary[ExtResource("s_item_type"), int]({
ExtResource("ore_olvane"): 75
})

[resource]
script = ExtResource("s_quest")
id = &"request_filter_frames"
title = "Filter frames"
kind = 2
giver = &"depot_master"
requires = Array[StringName]([&"depot_master.greeting"])
offer = SubResource("Topic_4")
steps = Array[ExtResource("s_step")]([SubResource("QuestStep_3")])
