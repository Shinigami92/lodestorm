[gd_resource type="Resource" script_class="NpcProfile" format=3 uid="uid://btff2f4twhwue"]

[ext_resource type="Script" uid="uid://c8q6bkm7m3hp6" path="res://game/npcs/npc_profile.gd" id="1_profile"]
[ext_resource type="Script" uid="uid://ddeb65xhvagk2" path="res://game/npcs/dialogue.gd" id="2_dialogue"]
[ext_resource type="Script" uid="uid://w5l30l8frnjf" path="res://game/npcs/topic.gd" id="3_topic"]
[ext_resource type="Resource" uid="uid://7jm5s1jr48n5" path="res://game/weapons/types/brask/brask.tres" id="4_brask"]
[ext_resource type="Script" uid="uid://dn5vusrjjqgbe" path="res://game/npcs/crew_reaction.gd" id="9_reaction"]
[ext_resource type="Script" uid="uid://dbr2l4vrjyctn" path="res://game/npcs/tour.gd" id="10_tour"]
[ext_resource type="Script" uid="uid://dkq75kl1xhc62" path="res://game/npcs/tour_stop.gd" id="11_tour_stop"]

[sub_resource type="Resource" id="Resource_greeting"]
script = ExtResource("3_topic")
id = &"quartermaster.greeting"
title = "Hello"
lines = Array[String](["Good, you're here. Before the next mission, let me tell you how the armory works. Keeping your gear and your ammo in order is my job.", "At your locker, pick the weapons you want to take on a mission. You can only carry up to two at a time, though.", "During a mission, you only have the weapons you carry. So choose wisely, or we'll be welcoming you in the medical bay.", "If you have questions about ammo or reloading, just ask me. Better here than out there with a swarm on your back."])


[sub_resource type="Resource" id="Resource_ammo"]
script = ExtResource("3_topic")
id = &"quartermaster.ammo"
title = "Ammo"
lines = Array[String](["Out there, your suit makes new rounds from the ore you carry on your back. Any kind of ore works. It always uses the lowest-quality ore first, so your rare ore lasts longest.", "The rarer the ore, the more rounds you get from the same amount.", "Once your spare magazines are used up, you can't reload without ore. So get your miners going early, or take Dray along: a hammer needs no ammo.", "Aboard, every reload is free: the rounds come from the ship's stock."])
requires = Array[StringName]([&"quartermaster.greeting"])

[sub_resource type="Resource" id="Resource_spares"]
script = ExtResource("3_topic")
id = &"quartermaster.spares"
title = "Spare magazines"
lines = Array[String](["Every ranged weapon you take along starts each mission with two spare magazines from the ship's stock. When you reload, those are used first, and they cost you no ore.", "Your suit can't make new spare magazines out there. Once they're gone, you pay for every reload with the ore you carry."])
requires = Array[StringName]([&"quartermaster.greeting"])

[sub_resource type="Resource" id="Resource_reload"]
script = ExtResource("3_topic")
id = &"quartermaster.reload"
title = "Reloading"
lines = Array[String](["You can reload whenever you want, as long as you still have a spare magazine or ore to pay for it. When the magazine runs empty, your weapon reloads by itself.", "But careful with Harl: reloading throws away the rounds still left in the magazine. So don't reload a half-full magazine just out of habit.", "While you reload, you walk slower. So pick a moment when nothing is right on your heels."])
requires = Array[StringName]([&"quartermaster.greeting"])

[sub_resource type="Resource" id="Resource_timing"]
script = ExtResource("3_topic")
id = &"quartermaster.timing"
title = "Timing reload"
lines = Array[String](["Here's a trick: reload a second time while you're still reloading. Every reload has one right moment for it, and you'll learn to feel when it comes.", "Hit that moment, and the reload is finished at once. Too early or too late, and it takes longer instead.", "If you don't reload a second time at all, it just takes the normal time. So try it at the shooting range first, where it costs you nothing."])
requires = Array[StringName]([&"quartermaster.reload"])

[sub_resource type="Resource" id="Resource_brask"]
script = ExtResource("3_topic")
id = &"quartermaster.shotgun"
title = "Brask"
lines = Array[String](["So you've got Brask now, the shotgun. It has no magazine: it loads one shell after another, and keeps the shells that are already in.", "Pull the trigger in the middle of a reload, and it stops reloading and fires what's loaded.", "The timing trick works on every single shell. Time several shells in a row, and each one loads a bit quicker. Miss one or skip one, and that bonus starts over."])
requires = Array[StringName]([&"quartermaster.greeting"])
requires_weapon = ExtResource("4_brask")

[sub_resource type="Resource" id="Resource_range"]
script = ExtResource("3_topic")
id = &"quartermaster.range"
title = "Shooting range"
lines = Array[String](["Right next to my armory is the shooting range. Whenever you get a new weapon, try it out there before you take it on a mission.", "Reloads there are free, so you can practice the timing as often as you like. The targets stand at the far end.", "Weapons only work inside the range, and a force field in the doorway stops every shot. Nothing leaves that room."])
requires = Array[StringName]([&"quartermaster.greeting"])

[sub_resource type="Resource" id="Resource_dialogue"]
script = ExtResource("2_dialogue")
greeting = SubResource("Resource_greeting")
prompts = Array[String](["How can I help you?", "Something on your mind?", "Go ahead, I'm listening.", "Questions about your gear?"])
topics = Array[ExtResource("3_topic")]([SubResource("Resource_ammo"), SubResource("Resource_spares"), SubResource("Resource_reload"), SubResource("Resource_timing"), SubResource("Resource_brask"), SubResource("Resource_range")])

[sub_resource type="Resource" id="Reaction_first_run_won_solo"]
script = ExtResource("9_reaction")
event = &"first_run_won"
players = 1
lines = Array[String](["You made it back in one piece, and with ore on your back. That's how I like a first mission to end."])

[sub_resource type="Resource" id="Reaction_first_run_won_coop"]
script = ExtResource("9_reaction")
event = &"first_run_won"
players = 2
lines = Array[String](["Everyone made it back in one piece, and with ore on their backs. That's how I like a first mission to end."])

[sub_resource type="Resource" id="Reaction_weapon_built"]
script = ExtResource("9_reaction")
event = &"weapon_built"
lines = Array[String](["I hear you've got a new weapon. If you want to take it along, pick it at your locker before the next mission.", "Another one for the armory. You'll find it on the wall with the others, so take whatever suits the next mission best.", "A new weapon is only as good as the hands holding it. Spend some time at the shooting range before the next mission."])

[sub_resource type="Resource" id="Reaction_big_haul"]
script = ExtResource("9_reaction")
event = &"big_haul"
lines = Array[String](["Now that's a haul. With that much ore aboard, a few of those upgrades are finally in reach.", "Good haul. Careless crews don't stay lucky for long, though. The next mission can go wrong just as fast.", "Another big haul. Keep this up, and Dace and Wren won't have a quiet minute."])

[sub_resource type="Resource" id="Tour_offer"]
script = ExtResource("3_topic")
id = &"quartermaster.tour_offer"
title = "Hello"
lines = Array[String](["There you are. Before the first mission, let me walk you through the ship once, so you know who does what and where to find them.", "It won't take long. If you'd rather look around on your own, that's fine too. You'll find me in the armory."])

[sub_resource type="Resource" id="Tour_invite"]
script = ExtResource("3_topic")
id = &"quartermaster.tour"
title = "Show me the ship"
lines = Array[String](["Follow me, then. We start in the mess hall and end in my armory, and I'll wait for you at every stop."])
requires = Array[StringName]([&"quartermaster.tour_offer"])

[sub_resource type="Resource" id="Tour_resume"]
script = ExtResource("3_topic")
id = &"quartermaster.tour_resume"
title = "Go on"
lines = Array[String](["Right, let's keep going."])

[sub_resource type="Resource" id="Tour_abort"]
script = ExtResource("3_topic")
id = &"quartermaster.tour_abort"
title = "End the tour"
lines = Array[String](["All right. You know where to find me: in the armory, on the lower deck."])

[sub_resource type="Resource" id="Tour_stop_MessHall"]
script = ExtResource("11_tour_stop")
id = &"MessHall"
lines = Array[String](["This is the mess hall. Fenna cooks for all of us, and she hears everything that goes on aboard, so it's worth stopping by."])

[sub_resource type="Resource" id="Tour_stop_Bridge"]
script = ExtResource("11_tour_stop")
id = &"Bridge"
lines = Array[String](["The bridge. Tamsin flies the ship, and here at the holo table you pick with her where we go next. Every trip starts at that table."])

[sub_resource type="Resource" id="Tour_stop_Cockpit"]
script = ExtResource("11_tour_stop")
id = &"Cockpit"
lines = Array[String](["Next door is the cockpit. Once a destination is set, the course is set at the flight console in here, and anyone can do that."])

[sub_resource type="Resource" id="Tour_stop_Lift"]
script = ExtResource("11_tour_stop")
id = &"Lift"
lines = Array[String](["This lift takes us down to the lower deck. Up here are the cabins and the bridge, and everything for your gear is down there."])

[sub_resource type="Resource" id="Tour_stop_MedicalBay"]
script = ExtResource("11_tour_stop")
id = &"MedicalBay"
lines = Array[String](["The medical bay. Ilse patches you up here, and if you fall out there, this is where you wake up again."])

[sub_resource type="Resource" id="Tour_stop_EngineRoom"]
script = ExtResource("11_tour_stop")
id = &"EngineRoom"
lines = Array[String](["The engine room. Okoro keeps the drive core running, and the heat shield around it decides how close to the star we can fly."])

[sub_resource type="Resource" id="Tour_stop_ShootingRange"]
script = ExtResource("11_tour_stop")
id = &"ShootingRange"
lines = Array[String](["The shooting range. Try every new weapon in here first. No shot leaves the room, and reloading costs you nothing."])

[sub_resource type="Resource" id="Tour_stop_Weapons"]
script = ExtResource("11_tour_stop")
id = &"Weapons"
lines = Array[String](["Dace's weapons room. He builds new weapons from their blueprints, and at his bench he makes yours better."])

[sub_resource type="Resource" id="Tour_stop_Armor"]
script = ExtResource("11_tour_stop")
id = &"Armor"
lines = Array[String](["Wren looks after your suit in here. Better armor means you can take more hits out there."])

[sub_resource type="Resource" id="Tour_stop_Skills"]
script = ExtResource("11_tour_stop")
id = &"Skills"
lines = Array[String](["The skill graph. Your suit learns new things in here, like a quick dash or more spare magazines."])

[sub_resource type="Resource" id="Tour_stop_Miners"]
script = ExtResource("11_tour_stop")
id = &"Miners"
lines = Array[String](["Hollis and the miners. They dig the ore out there, while you keep the aliens off them."])

[sub_resource type="Resource" id="Tour_stop_Armory"]
script = ExtResource("11_tour_stop")
id = &"Armory"
lines = Array[String](["And this is my armory, where the tour ends. The cargo bay and the ramp are right through there. Ask me about your weapons and ammo whenever you like."])

[sub_resource type="Resource" id="Tour"]
script = ExtResource("10_tour")
start = &"Start"
offer = SubResource("Tour_offer")
invite = SubResource("Tour_invite")
resume = SubResource("Tour_resume")
abort = SubResource("Tour_abort")
stops = Array[ExtResource("11_tour_stop")]([SubResource("Tour_stop_MessHall"), SubResource("Tour_stop_Bridge"), SubResource("Tour_stop_Cockpit"), SubResource("Tour_stop_Lift"), SubResource("Tour_stop_MedicalBay"), SubResource("Tour_stop_EngineRoom"), SubResource("Tour_stop_ShootingRange"), SubResource("Tour_stop_Weapons"), SubResource("Tour_stop_Armor"), SubResource("Tour_stop_Skills"), SubResource("Tour_stop_Miners"), SubResource("Tour_stop_Armory")])

[resource]
script = ExtResource("1_profile")
id = &"quartermaster"
display_name = "Brannik"
role = "Quartermaster"
model = "uid://r7da5xautqps"
activities = Array[StringName]([&"LookAround", &"Stretch", &"CheckWrist", &"Tap"])
accent_color = Color(0.65, 0.45, 1, 1)
dialogue = SubResource("Resource_dialogue")
reactions = Array[ExtResource("9_reaction")]([SubResource("Reaction_first_run_won_solo"), SubResource("Reaction_first_run_won_coop"), SubResource("Reaction_weapon_built"), SubResource("Reaction_big_haul")])
tour = SubResource("Tour")
