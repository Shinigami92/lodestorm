[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/talk_card.gd" id="1_script"]
[ext_resource type="Theme" path="res://assets/ui/terminal_theme.tres" id="2_theme"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card"]
content_margin_left = 24.0
content_margin_top = 18.0
content_margin_right = 24.0
content_margin_bottom = 18.0
bg_color = Color(0.025, 0.04, 0.055, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.3, 0.85, 1, 0.6)

[node name="TalkCard" type="PanelContainer"]
anchors_preset = 14
anchor_top = 0.5
anchor_right = 1.0
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
theme_override_styles/panel = SubResource("StyleBoxFlat_card")
script = ExtResource("1_script")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Name" type="Label" parent="Layout"]
unique_name_in_owner = true
auto_translate_mode = 2
layout_mode = 2
theme_type_variation = &"Title"
theme_override_font_sizes/font_size = 34

[node name="Role" type="Label" parent="Layout"]
unique_name_in_owner = true
auto_translate_mode = 2
layout_mode = 2
theme_override_font_sizes/font_size = 26

[node name="TopicTitle" type="Label" parent="Layout"]
unique_name_in_owner = true
auto_translate_mode = 2
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.85, 1, 1)
autowrap_mode = 3

[node name="Progress" type="Label" parent="Layout"]
unique_name_in_owner = true
auto_translate_mode = 2
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 0.6)
theme_override_font_sizes/font_size = 26

[node name="List" type="VBoxContainer" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8
