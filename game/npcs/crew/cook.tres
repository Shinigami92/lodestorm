[gd_resource type="Resource" script_class="NpcProfile" format=3 uid="uid://bfb5jhhy2trv5"]

[ext_resource type="Script" uid="uid://c8q6bkm7m3hp6" path="res://game/npcs/npc_profile.gd" id="1_profile"]
[ext_resource type="Script" uid="uid://ddeb65xhvagk2" path="res://game/npcs/dialogue.gd" id="2_dialogue"]
[ext_resource type="Script" uid="uid://w5l30l8frnjf" path="res://game/npcs/topic.gd" id="3_topic"]
[ext_resource type="PackedScene" uid="uid://blasvrv7cg3v2" path="res://game/npcs/crew/accessories/cook.tscn" id="4_accessory"]

[sub_resource type="Resource" id="Resource_greeting"]
script = ExtResource("3_topic")
id = &"cook.greeting"
title = "Hello"
lines = Array[String](["Hungry? Sit down anywhere. It's not fancy, but it's warm, and nobody out there is going to cook for you.", "Everyone comes through my mess hall sooner or later. So if you want to know what's going on aboard, I'm the one to ask."])

[sub_resource type="Resource" id="Resource_crew"]
script = ExtResource("3_topic")
id = &"cook.crew"
title = "The crew"
lines = Array[String](["Brannik runs the armory and the ammo. Dace improves your weapons in the weapons room, and Wren looks after your suit in the room next door.", "Hollis keeps the miners going. Ilse has the medical bay at the nose, and Okoro is down in the engine room with the heat shield.", "Tamsin flies the ship. You'll find her on the bridge, or in the cockpit while we're flying. And I'm up here, of course."])
requires = Array[StringName]([&"cook.greeting"])

[sub_resource type="Resource" id="Resource_news"]
script = ExtResource("3_topic")
id = &"cook.news"
title = "News"
lines = Array[String](["If you want news from the rest of the colony, dock at Waypost Ostra. Tamsin can take you there any time.", "Have a drink at the bar while you're there. Nell hears even more gossip than I do, and that's saying something."])
requires = Array[StringName]([&"cook.greeting"])

[sub_resource type="Resource" id="Resource_about"]
script = ExtResource("3_topic")
id = &"cook.about"
title = "About Fenna"
lines = Array[String](["I signed on to cook, but mostly I listen. Over a hot meal, people say more than they'd ever admit.", "Most of what I hear is nonsense. Some of it isn't. The trick is telling the difference."])
requires = Array[StringName]([&"cook.greeting"])

[sub_resource type="Resource" id="Resource_dialogue"]
script = ExtResource("2_dialogue")
greeting = SubResource("Resource_greeting")
prompt = "What'll it be?"
topics = Array[ExtResource("3_topic")]([SubResource("Resource_crew"), SubResource("Resource_news"), SubResource("Resource_about")])

[resource]
script = ExtResource("1_profile")
id = &"cook"
display_name = "Fenna"
role = "Cook"
accent_color = Color(1, 0.55, 0.8, 1)
accessory = ExtResource("4_accessory")
cabin = 8
dialogue = SubResource("Resource_dialogue")
